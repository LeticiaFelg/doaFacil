# ─── Servidor ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=troque_por_um_segredo_forte_aqui
JWT_EXPIRES_IN=7d

# ─── AWS ──────────────────────────────────────────────────
# Preencha com as credenciais do usuário IAM criado para o projeto.
# Nunca commite o .env com valores reais — apenas este .env.example.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── DynamoDB ─────────────────────────────────────────────
DYNAMODB_TABLE_USERS=doafacil_users
DYNAMODB_TABLE_ITEMS=doafacil_items
DYNAMODB_TABLE_RESERVATIONS=doafacil_reservations

# ─── CORS ─────────────────────────────────────────────────
# Desenvolvimento local: http://localhost:8080 ou *
# Com S3:  http://NOME-DO-BUCKET.s3-website-us-east-1.amazonaws.com
# Com tunnel: https://SEU-SUBDOMINIO.workers.dev
CORS_ORIGIN=*
