# ─── Servidor ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=troque_por_um_segredo_forte_aqui
JWT_EXPIRES_IN=7d

# ─── AWS ──────────────────────────────────────────────────
# Em desenvolvimento local, preencha com suas credenciais da AWS CLI
# Em produção (Lambda), deixe em branco — o Lambda usa a IAM Role automaticamente
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── DynamoDB ─────────────────────────────────────────────
DYNAMODB_TABLE_USERS=doafacil_users
DYNAMODB_TABLE_ITEMS=doafacil_items
DYNAMODB_TABLE_RESERVATIONS=doafacil_reservations

# ─── CORS ─────────────────────────────────────────────────
# Em produção, coloque a URL do seu bucket S3 / CloudFront
CORS_ORIGIN=http://localhost:8000
