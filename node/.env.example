# Ambiente
NODE_ENV=development
PORT=5000

# Banco de Dados local (API rodando fora do Docker)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/doafacil

# Docker Compose usa internamente:
# postgres://postgres:postgres@postgres:5432/doafacil

# JWT
JWT_SECRET=sua-chave-secreta-super-segura-aqui-mude-em-producao
JWT_EXPIRES_IN=24h

# CORS
FRONTEND_URL=http://localhost:8000
