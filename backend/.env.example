# Ambiente
NODE_ENV=development
PORT=5000

# Banco de Dados
DATABASE_URL=sqlite:./doafacil.db

# JWT
JWT_SECRET=sua-chave-secreta-super-segura-aqui-mude-em-producao
JWT_EXPIRES_IN=24h

# CORS
FRONTEND_URL=http://localhost:8000

# E-mail de redefinicao de senha
# Use EMAIL_PROVIDER=ethereal para testes gratuitos com preview no terminal.
# Use EMAIL_PROVIDER=smtp para Mailtrap ou outro SMTP.
EMAIL_PROVIDER=ethereal
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
