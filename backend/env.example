# ──────────────────────────────────────────────────────────
# ATENÇÃO: este arquivo é o MODELO. Copie-o para .env e
# preencha os valores reais. Nunca commite o .env.
#
# Localização correta: backend\.env  (raiz do backend, com ponto)
# ──────────────────────────────────────────────────────────

# ─── Servidor ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=troque_por_um_segredo_forte_aqui
JWT_EXPIRES_IN=7d

# ─── Banco de dados SQLite ────────────────────────────────
# Caminho relativo à raiz do backend. O arquivo será criado
# automaticamente na primeira execução.
DB_PATH=./doafacil.db

# ─── Upload de imagens ────────────────────────────────────
# Pasta onde os arquivos enviados serão salvos.
UPLOADS_DIR=./uploads

# Tamanho máximo por arquivo em bytes (padrão: 5 MB)
MAX_FILE_SIZE=5242880

# ─── CORS ─────────────────────────────────────────────────
# Desenvolvimento local: * ou http://localhost:8080
# Com S3: http://NOME-DO-BUCKET.s3-website-us-east-1.amazonaws.com
CORS_ORIGIN=*

# ─── URL pública do backend ───────────────────────────────
# Usada para montar a URL das imagens enviadas por upload.
# Desenvolvimento local: http://localhost:3000
# Com Cloudflare Tunnel: https://SEU-SUBDOMINIO.workers.dev
PUBLIC_URL=http://localhost:3000
